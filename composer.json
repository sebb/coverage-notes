{
    "name": "sebb/coverage-notes",
    "description": "Track and compare PHPUnit code coverage evolution using Git notes without third-party services.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "sebb"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-simplexml": "*",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/serializer": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Sebb\\CoverageNotes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sebb\\CoverageNotes\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/coverage-notes"
    ],
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover=coverage.xml"
    },
    "config": {
        "sort-packages": true
    }
}
