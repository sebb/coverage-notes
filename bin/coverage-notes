#!/usr/bin/env php
<?php

declare(strict_types=1);

use Composer\InstalledVersions;
use Sebb\CoverageNotes\Command\BackfillCommand;
use Sebb\CoverageNotes\Command\CompareCommand;
use Sebb\CoverageNotes\Command\HistoryCommand;
use Sebb\CoverageNotes\Command\RecordCommand;
use Symfony\Component\Console\Application;

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (is_file($autoloadPath)) {
        require_once $autoloadPath;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Composer autoload.php could not be found. Run 'composer install' first.\n");
    exit(1);
}

$version = '@git_version@';
if (str_starts_with($version, '@')) {
    $version = class_exists(InstalledVersions::class) && InstalledVersions::isInstalled('sebb/coverage-notes')
        ? (InstalledVersions::getPrettyVersion('sebb/coverage-notes') ?? 'dev')
        : 'dev';
}

$application = new Application('coverage-notes', $version);
$application->addCommands([
    new RecordCommand(),
    new CompareCommand(),
    new HistoryCommand(),
    new BackfillCommand(),
]);

exit($application->run());
